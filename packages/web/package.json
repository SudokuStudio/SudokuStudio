{
    "name": "@sudoku-studio/web",
    "private": true,
    "description": "This set of documents is a basic web UI for a sudoku solving/setting tool.",
    "type": "module",
    "scripts": {
        "clean": "rm -rf .svelte-kit build node_modules",
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "playwright test",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@material/ripple": "^14.0.0",
        "@playwright/test": "^1.52.0",
        "@sudoku-studio/board-examples": "workspace:*",
        "@sudoku-studio/board-format": "workspace:*",
        "@sudoku-studio/board-utils": "workspace:*",
        "@sudoku-studio/board": "workspace:*",
        "@sudoku-studio/elements": "workspace:*",
        "@sudoku-studio/elements-all": "workspace:*",
        "@sudoku-studio/schema": "workspace:*",
        "@sudoku-studio/solver-sat": "workspace:*",
        "@sudoku-studio/state-manager": "workspace:*",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "^2.16.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@types/debounce": "^1.2.0",
        "comlink": "^4.4.2",
        "debounce": "^1.2.1",
        "fuse.js": "^6.6.2",
        "hsluv": "0.1.0",
        "lz-string": "^1.5.0",
        "normalize.css": "^8.0.1",
        "sass-embedded": "^1.87.0",
        "save-svg-as-png": "^1.4.17",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.0.0",
        "vite": "^6.2.6"
    }
}
