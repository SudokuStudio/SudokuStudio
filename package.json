{
  "name": "sudoku-studio",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @sudoku-studio/web run dev",
    "test": "pnpm -r run --parallel --aggregate-output --reporter=append-only test",
    "check": "prettier --check . && pnpm -r --parallel --aggregate-output --reporter=append-only run check",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@material/ripple": "^11.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}