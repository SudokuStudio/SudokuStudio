{
    "name": "sudoku-studio",
    "version": "0.0.0",
    "homepage": "https://github.com/SudokuStudio/Sudoku#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SudokuStudio/Sudoku.git"
    },
    "bugs": {
        "url": "https://github.com/SudokuStudio/Sudoku/issues"
    },
    "contributors": [
        "David Clamage <dclamage@users.noreply.github.com>",
        "echoes <DancingGrumpyCat@users.noreply.github.com>",
        "Mingwei Samuel <mingwei.samuel@gmail.com>"
    ],
    "scripts": {
        "clean": "pnpm -r --parallel run clean && rm -rf node_modules",
        "build:all": "pnpm -r --parallel --aggregate-output --reporter=append-only run build",
        "build": "pnpm --filter @sudoku-studio/web run build",
        "dev": "pnpm --filter @sudoku-studio/web run dev",
        "test": "pnpm -r --parallel --aggregate-output --reporter=append-only run test",
        "check": "pnpm -r --parallel --aggregate-output --reporter=append-only run check",
        "format": "prettier --write .",
        "lint": "prettier --check"
    },
    "keywords": [],
    "author": "",
    "license": "GPL-3.0",
    "packageManager": "pnpm@10.10.0",
    "devDependencies": {
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^3.3.3",
        "typescript": "^5.8.3"
    }
}
