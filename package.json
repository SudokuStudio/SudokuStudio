{
    "name": "sudoku-studio",
    "version": "0.0.0",
    "license": "GPL-3.0",
    "homepage": "https://github.com/SudokuStudio/SudokuStudio#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SudokuStudio/SudokuStudio.git"
    },
    "bugs": {
        "url": "https://github.com/SudokuStudio/SudokuStudio/issues"
    },
    "contributors": [
        "David Clamage <dclamage@users.noreply.github.com>",
        "echoes <DancingGrumpyCat@users.noreply.github.com>",
        "Mingwei Samuel <mingwei.samuel@gmail.com>"
    ],
    "keywords": [],
    "packageManager": "pnpm@10.10.0",
    "scripts": {
        "clean": "pnpm -r --parallel run clean && rm -rf node_modules",
        "build:all": "pnpm -r --parallel --aggregate-output --reporter=append-only run build",
        "build": "pnpm --filter=web run build",
        "dev": "pnpm --filter=web run dev",
        "test": "pnpm -r --parallel --aggregate-output --reporter=append-only run test",
        "test:unit": "pnpm -r --parallel --aggregate-output --reporter=append-only run test:unit",
        "test:e2e": "pnpm --filter=web run test:e2e",
        "check": "pnpm -r --parallel --aggregate-output --reporter=append-only run check",
        "format": "prettier --write .",
        "lint": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^22.15.15",
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^3.3.3",
        "typescript": "^5.8.3"
    }
}
